        <mxCell id="a8" value="first token" style="endArrow=block;html=1;strokeColor=#333333;strokeWidth=2;fontSize=9;fontColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="subGen" target="outFirst">
