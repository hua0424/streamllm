        </mxCell>

        <!-- caption -->
        <mxCell id="caption" value="Producer&#8211;consumer queues let ASR transcription and LLM prefill overlap with the user&#8217;s speech; after End-of-Speech only the last chunk and thread synchronization remain on the critical path." style="text;html=1;align=center;fontSize=9;fontColor=#666666;" vertex="1" parent="1">
