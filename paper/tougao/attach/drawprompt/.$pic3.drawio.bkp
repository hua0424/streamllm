          <mxGeometry x="930" y="244" width="180" height="36" as="geometry" />
        </mxCell>
        <mxCell id="outFirst" value="First Token&#xa;(TTFT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9cc97f;strokeColor=#5b8a3a;fontSize=10;fontStyle=1;fontColor=#2f4d1e;" vertex="1" parent="1">
