# .env 模板 —— 复制为 .env 并按本机情况填写（.env 已被 gitignore，每台机器各自维护）

# 模型配置
LLM_MODEL_NAME="Qwen/Qwen2.5-0.5B-Instruct"   # 验证机用 0.5B；实验机改 "Qwen/Qwen2-7B-Instruct"
ASR_MODEL_NAME="turbo"                          # whisper 模型大小

# Hugging Face 配置
HF_HOME="/workspace/hfhome"                     # 模型缓存目录（各机自定）
HF_ENDPOINT="https://huggingface.co/"
HF_TOKEN=""                                     # 公开模型匿名即可；私有模型填入有效 token（勿提交真实 token）

# 日志配置
LOG_FILE="logs/experiment.log"

# 音频格式配置
TARGET_SAMPLE_RATE="16000"
TARGET_CHANNELS="1"
