<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="usr" value="用户语音" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="20" y="45" width="100" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="asr" value="流式 ASR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="180" y="45" width="110" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="seg" value="final 片段流&#10;u₁, u₂, …" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="350" y="45" width="120" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="llm" value="LLM&#10;增量 prefill ＋ KV 缓存 𝒦" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D6EBF5;strokeColor=#0072B2;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="540" y="35" width="190" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="trig" value="软触发&#10;TEN 置信度 cᵢ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#E69F00;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="290" y="160" width="130" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="spec" value="推测生成（可作废）&#10;【4.1　贡献 1】" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#E69F00;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="480" y="160" width="170" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="chk" value="断句器 CHK&#10;token→片段区间" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="180" y="280" width="140" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="tts" value="流式 TTS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="400" y="280" width="110" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="ply" value="播放器 PLY&#10;回报已播采样数 p" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="580" y="280" width="150" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="ear" value="用户" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="800" y="282" width="90" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="tl" value="播放时间轴 PlaybackTimeline：token ↔ 片段 ↔ 音频块 ↔ 采样区间　四向映射【4.2.1】" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F4FB;strokeColor=#56B4E9;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="180" y="390" width="550" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="brg" value="打断&#10;（用户插话）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9DFD0;strokeColor=#D55E00;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="790" y="480" width="110" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="lut" value="反查 Φ(p) → H(p)&#10;（亚毫秒）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9DFD0;strokeColor=#D55E00;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="590" y="480" width="150" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="crop" value="KV 截断＋角色重建&#10;【4.2　贡献 2（核心）】" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D6EBF5;strokeColor=#0072B2;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="350" y="480" width="180" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="hist" value="历史策略：朴素／标记／重写&#10;【4.3　贡献 3】" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5F0E6;strokeColor=#009E73;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
