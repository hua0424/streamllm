      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e1" value="cᵢ ≥ θ：记录推测起点 b := |𝒦|，&#10;注入 assistant 标记" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E69F00;fontSize=12;exitX=0.75;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1" target="s2">
