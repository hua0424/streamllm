    <mxCell id="e2" value="新片段 uᵢ 到达 → 作废：&#10;KV 截断回 b（合法截断 4.2.2），&#10;推测产出计入浪费率 ρ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D55E00;fontSize=12;exitX=0;exitY=0.85;entryX=1;entryY=0.5;" edge="1" parent="1" source="s2" target="s1">
